# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# Optional: a server ID to register commands to instantly while testing.
# Leave blank to register globally (works in every server the bot joins).
DEV_GUILD_ID=

# --- Web dashboard (optional) -----------------------------------------------
# Setting a client secret turns the dashboard on.
# Developer portal -> your app -> OAuth2 -> Client Secret -> Reset Secret
DISCORD_CLIENT_SECRET=

# The address people use to open the dashboard. Add <PUBLIC_URL>/auth/callback
# under OAuth2 -> Redirects in the developer portal.
PUBLIC_URL=http://localhost:3000

# Port to listen on. WEB_HOST=127.0.0.1 only accepts connections from this
# machine (use a reverse proxy to expose it); set 0.0.0.0 to listen on all interfaces.
WEB_PORT=3000
WEB_HOST=127.0.0.1
